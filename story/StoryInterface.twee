:: StoryInterface {"position":"280,50","size":"100,100"}
<div id="app">
<header class="vu-header"><div class="vu-brandbar"><img class="vu-logo" id="vuLogo" alt="Vanderbilt star logo"><span class="vu-wordmark">Vanderbilt University</span></div><div class="vu-gametitle">Commodore Crossroads</div></header>
<nav class="sec-tabs" aria-label="Sections">
<button class="sec-tab" type="button" data-sec="secGame" aria-selected="true">Game</button>
<button class="sec-tab" type="button" data-sec="secLR" aria-selected="false">Hall of Shame</button>
<button class="sec-tab" type="button" data-sec="secGallery" aria-selected="false">Gallery</button>
</nav>
<div class="app-grid">
<section class="col main-game active" id="secGame" aria-label="Game">
<div class="hud-wrap"><div class="hud" id="hud"></div></div>
<div class="gamebar"><button class="back-btn" id="backBtn" type="button" disabled>Back to Previous Choice</button><button class="sound-btn" id="soundBtn" type="button" aria-pressed="false" title="Join the Immersion Sounds Experience — looping background audio while you play"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 14v-2a8 8 0 0 1 16 0v2"></path><rect x="2.5" y="14" width="4" height="6" rx="1.5"></rect><rect x="17.5" y="14" width="4" height="6" rx="1.5"></rect></svg><span class="sfx-label">Join Immersion Sounds</span><span class="eq" aria-hidden="true"><i></i><i></i><i></i></span></button></div>
<main id="stage"><div id="passages"></div></main>
</section>
<section class="col side" id="secLR" aria-label="Hall of Shame, Game Rankings, and Resources">
<div class="card-lite">
<div class="tabs" role="tablist" aria-label="Hall of Shame, Game Rankings, and Resources">
<button class="tab" role="tab" id="tab-shame" aria-controls="panel-shame" aria-selected="true">Hall of Shame</button>
<button class="tab" role="tab" id="tab-rankings" aria-controls="panel-rankings" aria-selected="false" tabindex="-1">Game Rankings</button>
<button class="tab" role="tab" id="tab-resources" aria-controls="panel-resources" aria-selected="false" tabindex="-1">Resources</button>
</div>
<div class="tabpanel active" role="tabpanel" id="panel-shame" aria-labelledby="tab-shame"></div>
<div class="tabpanel" role="tabpanel" id="panel-rankings" aria-labelledby="tab-rankings"></div>
<div class="tabpanel" role="tabpanel" id="panel-resources" aria-labelledby="tab-resources"></div>
</div>
</section>
<section class="col side" id="secGallery" aria-label="Gallery">
<div class="card-lite" id="galleryCard"></div>
</section>
</div>
<footer class="vu-footer"><span>Student-created interactive project. Not an official Vanderbilt University website.</span></footer>
</div>
